{
  "expo": {
    "name": "Slate",
    "slug": "slate",
    "scheme": "slate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sonalsystems.slate",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Slate uses the camera to scan barcodes and nutrition labels.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sonalsystems.slate",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "expo-splash-screen",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Slate uses the camera to scan barcodes and nutrition labels."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
