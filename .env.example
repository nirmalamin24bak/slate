# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Supabase (project ref ruynujwntbcgznoiwugl, region ap-south-1 Mumbai) ---
# EXPO_PUBLIC_* values are bundled into the client. The anon key is safe to
# ship: RLS protects every row.
EXPO_PUBLIC_SUPABASE_URL=https://ruynujwntbcgznoiwugl.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only: Edge Function secrets and local scripts.
# Bypasses RLS. NEVER prefix with EXPO_PUBLIC_. NEVER import into app code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resolver model provider (Phase 2; spec/05) ---
# Server-side only: Edge Function secret (supabase secrets set) + the local
# eval harness (test/resolver-eval.test.ts). NEVER prefix with EXPO_PUBLIC_.
# FLAG(nirmal): provider choice + DPDP zero-retention processor terms pending.
RESOLVER_PROVIDER=anthropic
RESOLVER_PROVIDER_API_KEY=
RESOLVER_MODEL=claude-haiku-4-5

# --- RevenueCat (Phase 5; Apple IAP only) ---
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Dev-only: force Plus in a dev build to exercise the free/Plus matrix without
# IAP. Read only under __DEV__; stripped from release bundles. Set to 1.
# EXPO_PUBLIC_DEV_FORCE_PLUS=
# Server-side only (Edge Function secrets). The webhook shared secret matches
# the Authorization header configured in the RevenueCat dashboard; the secret
# API key lets entitlement-refresh query RC's REST API. NEVER prefix EXPO_PUBLIC_.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_SECRET_API_KEY=

# --- Resolver kill switch (plan A5) ---
# Server-side only. Set to 1 in the resolver-classify function's secrets to
# stop all model calls without a redeploy (provider outage / cost spike).
# RESOLVER_DISABLED=

# --- PostHog (events only; raw_text never sent) ---
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
